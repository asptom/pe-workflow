# Copy to `.env` (gitignored) and fill in real values before running `npm test`.
# Credentials come from the `c8ctl-credentials` secret in namespace `camunda`.

BFF_URL=http://localhost:8088
C8CTL_PROFILE=rancher-desktop
ZEEBE_CLIENT_ID=zeebe-cli
ZEEBE_CLIENT_SECRET=replace-with-value-from-c8ctl-credentials-secret