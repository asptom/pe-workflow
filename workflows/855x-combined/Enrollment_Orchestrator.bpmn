<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_EnrollmentOrchestrator" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="Enrollment_Orchestrator" name="CMS Provider Enrollment Orchestrator" isExecutable="true">
    <bpmn:startEvent id="Start_Enrollment" name="Enrollment application received">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="enrollment-start" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_Start_DocDetermination</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="Task_DocDetermination" name="Determine required documentation">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="Enrollment_Documentation" resultVariable="documentationResult" />
        <zeebe:ioMapping>
          <zeebe:input source="=provider.enrollmentType" target="enrollmentType" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_DocDetermination</bpmn:incoming>
      <bpmn:outgoing>Flow_DocDetermination_GenerateDoc</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="Task_GenerateDocumentation" name="Generate required documentation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generate-doc" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DocDetermination_GenerateDoc</bpmn:incoming>
      <bpmn:outgoing>Flow_GenerateDoc_TypeGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_EnrollmentType" name="Enrollment type?" default="Flow_Type_855B">
      <bpmn:incoming>Flow_GenerateDoc_TypeGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Type_855I</bpmn:outgoing>
      <bpmn:outgoing>Flow_Type_855A</bpmn:outgoing>
      <bpmn:outgoing>Flow_Type_855B</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="Call_Delegate_855I" name="Execute 855I individual practitioner enrollment">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Delegate_855I" propagateAllChildVariables="true" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Type_855I</bpmn:incoming>
      <bpmn:outgoing>Flow_855I_Merge</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Call_Delegate_855A" name="Execute 855A organization facility enrollment">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Delegate_855A" propagateAllChildVariables="true" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Type_855A</bpmn:incoming>
      <bpmn:outgoing>Flow_855A_Merge</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="Call_Delegate_855B" name="Execute 855B DMEPOS supplier enrollment">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Delegate_855B" propagateAllChildVariables="true" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Type_855B</bpmn:incoming>
      <bpmn:outgoing>Flow_855B_Merge</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_MergeDelegates">
      <bpmn:incoming>Flow_855I_Merge</bpmn:incoming>
      <bpmn:incoming>Flow_855A_Merge</bpmn:incoming>
      <bpmn:incoming>Flow_855B_Merge</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeDelegates_Eligibility</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Task_EligibilityCheck" name="Evaluate enrollment eligibility">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="Eligibility_Rules" resultVariable="eligibilityResult" />
        <zeebe:ioMapping>
          <zeebe:input source="=provider.enrollmentType" target="enrollmentType" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_MergeDelegates_Eligibility</bpmn:incoming>
      <bpmn:outgoing>Flow_Eligibility_Gateway</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Eligibility" name="Eligibility decision?" default="Flow_Eligibility_Eligible">
      <bpmn:incoming>Flow_Eligibility_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Eligibility_Ineligible</bpmn:outgoing>
      <bpmn:outgoing>Flow_Eligibility_Conditional</bpmn:outgoing>
      <bpmn:outgoing>Flow_Eligibility_Eligible</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_SendIneligibility" name="Send ineligibility notice to provider">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-notification">
          <zeebe:taskHeaders>
            <zeebe:taskHeader key="kind" value="ineligibility" />
          </zeebe:taskHeaders>
        </zeebe:taskDefinition>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;ineligibility&quot;" target="kind" />
          <zeebe:output source="=notificationStatus" target="ineligibilityNoticeStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Eligibility_Ineligible</bpmn:incoming>
      <bpmn:outgoing>Flow_Ineligibility_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Ineligible" name="Enrollment ineligible">
      <bpmn:incoming>Flow_Ineligibility_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_RequestAdditionalInfo" name="Request additional information from provider">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-notification">
          <zeebe:taskHeaders>
            <zeebe:taskHeader key="kind" value="additional-info" />
          </zeebe:taskHeaders>
        </zeebe:taskDefinition>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;additional-info&quot;" target="kind" />
          <zeebe:output source="=notificationStatus" target="additionalInfoRequestStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Eligibility_Conditional</bpmn:incoming>
      <bpmn:outgoing>Flow_AdditionalInfo_Timer</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Timer_AdditionalInfo" name="30-day response window">
      <bpmn:incoming>Flow_AdditionalInfo_Timer</bpmn:incoming>
      <bpmn:outgoing>Flow_Timer_AdditionalInfo_Merge</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_AdditionalInfo">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">="PT5S"</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_MergeEligibility">
      <bpmn:incoming>Flow_Eligibility_Eligible</bpmn:incoming>
      <bpmn:incoming>Flow_Timer_AdditionalInfo_Merge</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeEligibility_Timeline</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Task_CalculateTimeline" name="Calculate processing timeline">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="Processing_Timeline" resultVariable="timelineResult" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_MergeEligibility_Timeline</bpmn:incoming>
      <bpmn:outgoing>Flow_Timeline_ForwardCMS</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="Task_ForwardToCMS" name="Forward complete application to CMS Provider Enrollment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-notification">
          <zeebe:taskHeaders>
            <zeebe:taskHeader key="kind" value="cms-forward" />
          </zeebe:taskHeaders>
        </zeebe:taskDefinition>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;cms-forward&quot;" target="kind" />
          <zeebe:output source="=notificationStatus" target="cmsForwardStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Timeline_ForwardCMS</bpmn:incoming>
      <bpmn:outgoing>Flow_ForwardCMS_Timer</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Timer_CMSDecision" name="CMS review period (30 days)">
      <bpmn:incoming>Flow_ForwardCMS_Timer</bpmn:incoming>
      <bpmn:outgoing>Flow_Timer_CMSDecision_Gateway</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_CMSDecision">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">="PT5S"</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_SimulateCMSDecision" name="Simulate CMS decision">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="simulate-cms-decision" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Timer_CMSDecision_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_SimCMSDecision_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_CMSDecision" name="CMS decision?" default="Flow_CMS_Denied">
      <bpmn:incoming>Flow_SimCMSDecision_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_CMS_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_CMS_Denied</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_SendApproval" name="Send enrollment approval letter to provider">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-notification">
          <zeebe:taskHeaders>
            <zeebe:taskHeader key="kind" value="approval" />
          </zeebe:taskHeaders>
        </zeebe:taskDefinition>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;approval&quot;" target="kind" />
          <zeebe:output source="=notificationStatus" target="approvalLetterStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CMS_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_Approval_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Approved" name="Enrollment approved">
      <bpmn:incoming>Flow_Approval_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_SendDenial" name="Send enrollment denial letter to provider">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-notification">
          <zeebe:taskHeaders>
            <zeebe:taskHeader key="kind" value="denial" />
          </zeebe:taskHeaders>
        </zeebe:taskDefinition>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;denial&quot;" target="kind" />
          <zeebe:output source="=notificationStatus" target="denialLetterStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CMS_Denied</bpmn:incoming>
      <bpmn:outgoing>Flow_Denial_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Denied" name="Enrollment denied">
      <bpmn:incoming>Flow_Denial_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_DocDetermination" sourceRef="Start_Enrollment" targetRef="Task_DocDetermination" />
    <bpmn:sequenceFlow id="Flow_DocDetermination_GenerateDoc" sourceRef="Task_DocDetermination" targetRef="Task_GenerateDocumentation" />
    <bpmn:sequenceFlow id="Flow_GenerateDoc_TypeGateway" sourceRef="Task_GenerateDocumentation" targetRef="Gateway_EnrollmentType" />
    <bpmn:sequenceFlow id="Flow_Type_855I" name="855I" sourceRef="Gateway_EnrollmentType" targetRef="Call_Delegate_855I">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=provider.enrollmentType = "855I"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Type_855A" name="855A" sourceRef="Gateway_EnrollmentType" targetRef="Call_Delegate_855A">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=provider.enrollmentType = "855A"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Type_855B" name="855B" sourceRef="Gateway_EnrollmentType" targetRef="Call_Delegate_855B" />
    <bpmn:sequenceFlow id="Flow_855I_Merge" sourceRef="Call_Delegate_855I" targetRef="Gateway_MergeDelegates" />
    <bpmn:sequenceFlow id="Flow_855A_Merge" sourceRef="Call_Delegate_855A" targetRef="Gateway_MergeDelegates" />
    <bpmn:sequenceFlow id="Flow_855B_Merge" sourceRef="Call_Delegate_855B" targetRef="Gateway_MergeDelegates" />
    <bpmn:sequenceFlow id="Flow_MergeDelegates_Eligibility" sourceRef="Gateway_MergeDelegates" targetRef="Task_EligibilityCheck" />
    <bpmn:sequenceFlow id="Flow_Eligibility_Gateway" sourceRef="Task_EligibilityCheck" targetRef="Gateway_Eligibility" />
    <bpmn:sequenceFlow id="Flow_Eligibility_Ineligible" name="Ineligible" sourceRef="Gateway_Eligibility" targetRef="Task_SendIneligibility">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=eligibilityResult.eligibilityStatus = "INELIGIBLE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Eligibility_Conditional" name="Conditional" sourceRef="Gateway_Eligibility" targetRef="Task_RequestAdditionalInfo">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=eligibilityResult.eligibilityStatus = "CONDITIONAL"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Eligibility_Eligible" name="Eligible" sourceRef="Gateway_Eligibility" targetRef="Gateway_MergeEligibility" />
    <bpmn:sequenceFlow id="Flow_Ineligibility_End" sourceRef="Task_SendIneligibility" targetRef="EndEvent_Ineligible" />
    <bpmn:sequenceFlow id="Flow_AdditionalInfo_Timer" sourceRef="Task_RequestAdditionalInfo" targetRef="Timer_AdditionalInfo" />
    <bpmn:sequenceFlow id="Flow_Timer_AdditionalInfo_Merge" sourceRef="Timer_AdditionalInfo" targetRef="Gateway_MergeEligibility" />
    <bpmn:sequenceFlow id="Flow_MergeEligibility_Timeline" sourceRef="Gateway_MergeEligibility" targetRef="Task_CalculateTimeline" />
    <bpmn:sequenceFlow id="Flow_Timeline_ForwardCMS" sourceRef="Task_CalculateTimeline" targetRef="Task_ForwardToCMS" />
    <bpmn:sequenceFlow id="Flow_ForwardCMS_Timer" sourceRef="Task_ForwardToCMS" targetRef="Timer_CMSDecision" />
    <bpmn:sequenceFlow id="Flow_Timer_CMSDecision_Gateway" sourceRef="Timer_CMSDecision" targetRef="Task_SimulateCMSDecision" />
    <bpmn:sequenceFlow id="Flow_SimCMSDecision_Gateway" sourceRef="Task_SimulateCMSDecision" targetRef="Gateway_CMSDecision" />
    <bpmn:sequenceFlow id="Flow_CMS_Approved" name="Approved" sourceRef="Gateway_CMSDecision" targetRef="Task_SendApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=cmsDecision = "Approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CMS_Denied" name="Denied" sourceRef="Gateway_CMSDecision" targetRef="Task_SendDenial" />
    <bpmn:sequenceFlow id="Flow_Approval_End" sourceRef="Task_SendApproval" targetRef="EndEvent_Approved" />
    <bpmn:sequenceFlow id="Flow_Denial_End" sourceRef="Task_SendDenial" targetRef="EndEvent_Denied" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Enrollment_Orchestrator">
      <bpmndi:BPMNShape id="Start_Enrollment_di" bpmnElement="Start_Enrollment">
        <dc:Bounds x="152" y="302" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="127" y="345" width="86" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DocDetermination_di" bpmnElement="Task_DocDetermination">
        <dc:Bounds x="240" y="280" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GenerateDocumentation_di" bpmnElement="Task_GenerateDocumentation">
        <dc:Bounds x="350" y="280" width="80" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_EnrollmentType_di" bpmnElement="Gateway_EnrollmentType" isMarkerVisible="true">
        <dc:Bounds x="440" y="295" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="422" y="352" width="86" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_Delegate_855I_di" bpmnElement="Call_Delegate_855I">
        <dc:Bounds x="540" y="130" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_Delegate_855A_di" bpmnElement="Call_Delegate_855A">
        <dc:Bounds x="540" y="280" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_Delegate_855B_di" bpmnElement="Call_Delegate_855B">
        <dc:Bounds x="540" y="430" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_MergeDelegates_di" bpmnElement="Gateway_MergeDelegates">
        <dc:Bounds x="740" y="295" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EligibilityCheck_di" bpmnElement="Task_EligibilityCheck">
        <dc:Bounds x="840" y="280" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Eligibility_di" bpmnElement="Gateway_Eligibility" isMarkerVisible="true">
        <dc:Bounds x="1040" y="295" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1021" y="352" width="88" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendIneligibility_di" bpmnElement="Task_SendIneligibility">
        <dc:Bounds x="1140" y="130" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Ineligible_di" bpmnElement="EndEvent_Ineligible">
        <dc:Bounds x="1342" y="152" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1319" y="195" width="82" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RequestAdditionalInfo_di" bpmnElement="Task_RequestAdditionalInfo">
        <dc:Bounds x="1140" y="280" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Timer_AdditionalInfo_di" bpmnElement="Timer_AdditionalInfo">
        <dc:Bounds x="1342" y="302" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1319" y="345" width="82" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_MergeEligibility_di" bpmnElement="Gateway_MergeEligibility">
        <dc:Bounds x="1445" y="295" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CalculateTimeline_di" bpmnElement="Task_CalculateTimeline">
        <dc:Bounds x="1540" y="280" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ForwardToCMS_di" bpmnElement="Task_ForwardToCMS">
        <dc:Bounds x="1740" y="280" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Timer_CMSDecision_di" bpmnElement="Timer_CMSDecision">
        <dc:Bounds x="1942" y="302" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1919" y="345" width="82" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SimulateCMSDecision_di" bpmnElement="Task_SimulateCMSDecision">
        <dc:Bounds x="1990" y="280" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CMSDecision_di" bpmnElement="Gateway_CMSDecision" isMarkerVisible="true">
        <dc:Bounds x="2100" y="295" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2082" y="352" width="86" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendApproval_di" bpmnElement="Task_SendApproval">
        <dc:Bounds x="2140" y="180" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Approved_di" bpmnElement="EndEvent_Approved">
        <dc:Bounds x="2342" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2317" y="245" width="86" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendDenial_di" bpmnElement="Task_SendDenial">
        <dc:Bounds x="2140" y="380" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Denied_di" bpmnElement="EndEvent_Denied">
        <dc:Bounds x="2342" y="402" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2327" y="445" width="66" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_DocDetermination_di" bpmnElement="Flow_Start_DocDetermination">
        <di:waypoint x="188" y="320" />
        <di:waypoint x="240" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DocDetermination_GenerateDoc_di" bpmnElement="Flow_DocDetermination_GenerateDoc">
        <di:waypoint x="340" y="320" />
        <di:waypoint x="350" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_GenerateDoc_TypeGateway_di" bpmnElement="Flow_GenerateDoc_TypeGateway">
        <di:waypoint x="430" y="320" />
        <di:waypoint x="440" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Type_855I_di" bpmnElement="Flow_Type_855I">
