        <di:waypoint x="840" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_855A_5" bpmnElement="Flow_855A_5">
        <di:waypoint x="940" y="220" />
        <di:waypoint x="1040" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_855A_6" bpmnElement="Flow_855A_6">
