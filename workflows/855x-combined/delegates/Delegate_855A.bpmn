        <di:waypoint x="1240" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_855A_7" bpmnElement="Flow_855A_7">
        <di:waypoint x="1340" y="220" />
        <di:waypoint x="1440" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_855A_8" bpmnElement="Flow_855A_8">
        <di:waypoint x="1540" y="220" />
        <di:waypoint x="1640" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_855A_9" bpmnElement="Flow_855A_9">
