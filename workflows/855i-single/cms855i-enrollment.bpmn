<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_CMS855I_MAC" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="c72e043" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="cms855i-mac-enrollment" name="CMS-855I MAC Enrollment Processing" isExecutable="true">
    <bpmn:startEvent id="Start_ReceiveApp" name="Application received">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="cms855i-start-form" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_ReceiveApp_Intake</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="Task_Intake" name="Intake — log application and assign tracking number">
      <bpmn:extensionElements>
        <zeebe:script expression="=&#34;Application logged. MAC Tracking: &#34; + macTrackingNumber + &#34;. Submission method: &#34; + submissionMethod + &#34;. Filing date: &#34; + filingDate" resultVariable="intakeRecord" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ReceiveApp_Intake</bpmn:incoming>
      <bpmn:outgoing>Flow_058lvwi</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_Validate" name="Validate NPI, TIN, license and enrollment data">
      <bpmn:extensionElements>
        <zeebe:script expression="=&#34;Validation complete. NPI active: &#34; + string(npiIsActive) + &#34;. TIN matches: &#34; + string(npiMatchesTIN) + &#34;. License valid: &#34; + string(licenseValid)" resultVariable="validationResult" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_058lvwi</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate_Completeness</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_Verify" name="OIG/SAM exclusion screening and verification">
      <bpmn:extensionElements>
        <zeebe:script expression="=&#34;OIG cleared: &#34; + string(oigCleared) + &#34;. SAM cleared: &#34; + string(samCleared) + &#34;. Fingerprint status: &#34; + fingerprintStatus" resultVariable="verificationResult" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Validate_Completeness</bpmn:incoming>
      <bpmn:outgoing>Flow_Verify_CompletenessCheck</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:businessRuleTask id="Task_CompletenessCheck" name="Determine application completeness and required documentation">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="required-documentation" resultVariable="completenessResult" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Verify_CompletenessCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_Completeness_Gateway</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Completeness" name="Application complete?" default="Flow_Complete_No">
      <bpmn:incoming>Flow_Completeness_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Complete_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Complete_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_DevelopmentRequest" name="Send development request for missing information">
      <bpmn:extensionElements>
        <zeebe:script expression="=&#34;Development request sent to provider. Missing: &#34; + completenessResult.requiredDocuments + &#34;. Response deadline: 30 days.&#34;" resultVariable="developmentRequestStatus" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Complete_No</bpmn:incoming>
      <bpmn:outgoing>Flow_DevReq_Timer</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:intermediateCatchEvent id="Timer_ResponseWindow" name="30-day response window">
      <bpmn:incoming>Flow_DevReq_Timer</bpmn:incoming>
      <bpmn:outgoing>Flow_Timer_ResponseCheck</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Response">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_ResponseCheck" name="Provider responded?" default="Flow_Response_No">
      <bpmn:incoming>Flow_Timer_ResponseCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_Response_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Response_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_ReturnApplication" name="Return application — no response received">
      <bpmn:extensionElements>
        <zeebe:script expression="=&#34;Application returned to provider. Reason: No response to development request within 30 days. MAC Tracking: &#34; + macTrackingNumber" resultVariable="returnStatus" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Response_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Return_End</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="EndEvent_Returned" name="Application returned">
      <bpmn:incoming>Flow_Return_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="Task_ReviewResponse" name="Review supplemental documentation received">
      <bpmn:extensionElements>
        <zeebe:script expression="=&#34;Supplemental documentation received and reviewed. Application updated.&#34;" resultVariable="responseReviewStatus" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Response_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_03h45ca</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_MergeSAReferral">
      <bpmn:incoming>Flow_Complete_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_SiteVisit_SAReferral</bpmn:incoming>
      <bpmn:incoming>Flow_03h45ca</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeSAReferral_Referral</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_SAReferral" name="Refer application to State Agency or Accrediting Organization">
      <bpmn:extensionElements>
        <zeebe:script expression="=&#34;Application referred to &#34; + referralEntity + &#34;. Referral date: &#34; + referralDate + &#34;. Estimated review: 45 days.&#34;" resultVariable="referralStatus" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_MergeSAReferral_Referral</bpmn:incoming>
      <bpmn:outgoing>Flow_SAReferral_Timer</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:intermediateCatchEvent id="Timer_SAReview" name="SA/AO review period (45 days)">
      <bpmn:incoming>Flow_SAReferral_Timer</bpmn:incoming>
      <bpmn:outgoing>Flow_Timer_SAReviewCheck</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_SAReview">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P45D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_SAReview" name="SA/AO response received?" default="Flow_SA_No">
      <bpmn:incoming>Flow_Timer_SAReviewCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_SA_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_SA_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_FollowUpSA" name="Follow up with State Agency or Accrediting Organization">
      <bpmn:extensionElements>
        <zeebe:script expression="=&#34;Follow-up sent to &#34; + referralEntity + &#34;. Awaiting response.&#34;" resultVariable="followUpStatus" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SA_No</bpmn:incoming>
      <bpmn:outgoing>Flow_FollowUp_Timer</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:intermediateCatchEvent id="Timer_FollowUp" name="Additional wait (14 days)">
      <bpmn:incoming>Flow_FollowUp_Timer</bpmn:incoming>
      <bpmn:outgoing>Flow_FollowUp_SAReviewCheck</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_FollowUp">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_FollowUpCheck" name="SA/AO responded after follow-up?" default="Flow_FollowUp_No">
      <bpmn:incoming>Flow_FollowUp_SAReviewCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_FollowUp_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_FollowUp_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_EscalateToCMS" name="Escalate to CMS Provider Enrollment">
      <bpmn:extensionElements>
        <zeebe:script expression="=&#34;Escalated to CMS Provider Enrollment. SA/AO non-responsive after follow-up.&#34;" resultVariable="escalationStatus" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FollowUp_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Escalate_Forward</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_MergeSAResults">
      <bpmn:incoming>Flow_SA_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_FollowUp_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_Escalate_Forward</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeSAResults_Log</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_LogSAResults" name="Receive and log SA/AO review results">
      <bpmn:extensionElements>
        <zeebe:script expression="=&#34;SA/AO review received. Recommendation: &#34; + saAoRecommendation + &#34;. Site visit required: &#34; + string(saAoSiteVisitRequired)" resultVariable="saResultsLogged" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_MergeSAResults_Log</bpmn:incoming>
      <bpmn:outgoing>Flow_LogSA_SiteVisitDetermination</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:businessRuleTask id="Task_SiteVisitDetermination" name="Determine site visit requirement">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="site-visit-determination" resultVariable="siteVisitResult" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_LogSA_SiteVisitDetermination</bpmn:incoming>
      <bpmn:outgoing>Flow_SiteVisitDec_Gateway</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_SiteVisit" name="Site visit required?" default="Flow_SV_No">
      <bpmn:incoming>Flow_SiteVisitDec_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_SV_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_SV_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_OrderSiteVisit" name="Order site visit through PECOS">
      <bpmn:extensionElements>
        <zeebe:script expression="=&#34;Site visit ordered via PECOS. Type: &#34; + siteVisitResult.siteVisitType + &#34;. Assigned to National Site Visit Contractor.&#34;" resultVariable="siteVisitOrderStatus" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SV_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_OrderSV_Timer</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:intermediateCatchEvent id="Timer_SiteVisit" name="Site visit completion period (45 days)">
      <bpmn:incoming>Flow_OrderSV_Timer</bpmn:incoming>
      <bpmn:outgoing>Flow_Timer_SVResults</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_SiteVisit">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P45D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:scriptTask id="Task_SiteVisitResults" name="Receive and review site visit results">
      <bpmn:extensionElements>
        <zeebe:script expression="=&#34;Site visit results received. Outcome: &#34; + siteVisitOutcome + &#34;. Provider site verified: &#34; + string(siteVerified)" resultVariable="siteVisitResultsStatus" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Timer_SVResults</bpmn:incoming>
      <bpmn:outgoing>Flow_SiteVisit_SAReferral</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="Task_ForwardToCMS" name="Forward complete application to CMS Provider Enrollment">
      <bpmn:extensionElements>
        <zeebe:script expression="=&#34;Complete application packet forwarded to CMS Provider Enrollment. Includes: MAC recommendation, SA/AO results, site visit results (if applicable).&#34;" resultVariable="cmsForwardStatus" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_LogSA_SiteVisitDetermination</bpmn:incoming>
      <bpmn:outgoing>Flow_Forward_CMSDecision</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:intermediateCatchEvent id="Timer_CMSDecision" name="CMS review period (30 days)">
      <bpmn:incoming>Flow_Forward_CMSDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_Timer_CMSCheck</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_CMSDecision">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P30D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_CMSDecision" name="CMS decision?" default="Flow_CMS_Denied">
      <bpmn:incoming>Flow_Timer_CMSCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_CMS_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_CMS_Denied</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="Task_SendApproval" name="Send enrollment approval letter to provider">
      <bpmn:extensionElements>
        <zeebe:script expression="=&#34;Approval letter sent. CCN: &#34; + cmsCertificationNumber + &#34;. PTAN: &#34; + ptanNumber + &#34;. Effective date: &#34; + effectiveDate + &#34;. Copies to SA/AO.&#34;" resultVariable="approvalLetterStatus" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CMS_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_Approval_End</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="EndEvent_Approved" name="Enrollment approved — letter sent">
      <bpmn:incoming>Flow_Approval_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="Task_SendDenial" name="Send enrollment denial letter to provider">
      <bpmn:extensionElements>
        <zeebe:script expression="=&#34;Denial letter sent. Reason: &#34; + denialReason + &#34;. Provider may appeal or resubmit corrected application.&#34;" resultVariable="denialLetterStatus" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CMS_Denied</bpmn:incoming>
      <bpmn:outgoing>Flow_Denial_End</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="EndEvent_Denied" name="Enrollment denied — letter sent">
      <bpmn:incoming>Flow_Denial_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ReceiveApp_Intake" sourceRef="Start_ReceiveApp" targetRef="Task_Intake" />
    <bpmn:sequenceFlow id="Flow_Validate_Completeness" sourceRef="Task_Validate" targetRef="Task_Verify" />
    <bpmn:sequenceFlow id="Flow_Verify_CompletenessCheck" sourceRef="Task_Verify" targetRef="Task_CompletenessCheck" />
    <bpmn:sequenceFlow id="Flow_Completeness_Gateway" sourceRef="Task_CompletenessCheck" targetRef="Gateway_Completeness" />
    <bpmn:sequenceFlow id="Flow_Complete_Yes" name="Complete" sourceRef="Gateway_Completeness" targetRef="Gateway_MergeSAReferral">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=applicationComplete = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Complete_No" name="Incomplete" sourceRef="Gateway_Completeness" targetRef="Task_DevelopmentRequest" />
    <bpmn:sequenceFlow id="Flow_DevReq_Timer" sourceRef="Task_DevelopmentRequest" targetRef="Timer_ResponseWindow" />
    <bpmn:sequenceFlow id="Flow_Timer_ResponseCheck" sourceRef="Timer_ResponseWindow" targetRef="Gateway_ResponseCheck" />
    <bpmn:sequenceFlow id="Flow_Response_Yes" name="Responded" sourceRef="Gateway_ResponseCheck" targetRef="Task_ReviewResponse">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=providerResponded = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Response_No" name="No response" sourceRef="Gateway_ResponseCheck" targetRef="Task_ReturnApplication" />
    <bpmn:sequenceFlow id="Flow_Return_End" sourceRef="Task_ReturnApplication" targetRef="EndEvent_Returned" />
    <bpmn:sequenceFlow id="Flow_SAReferral_Timer" sourceRef="Task_SAReferral" targetRef="Timer_SAReview" />
    <bpmn:sequenceFlow id="Flow_Timer_SAReviewCheck" sourceRef="Timer_SAReview" targetRef="Gateway_SAReview" />
    <bpmn:sequenceFlow id="Flow_MergeSAReferral_Referral" sourceRef="Gateway_MergeSAReferral" targetRef="Task_SAReferral" />

    <bpmn:sequenceFlow id="Flow_SA_Yes" name="Received" sourceRef="Gateway_SAReview" targetRef="Gateway_MergeSAResults">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=saAoResponseReceived = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SA_No" name="No response" sourceRef="Gateway_SAReview" targetRef="Task_FollowUpSA" />
    <bpmn:sequenceFlow id="Flow_FollowUp_Timer" sourceRef="Task_FollowUpSA" targetRef="Timer_FollowUp" />
    <bpmn:sequenceFlow id="Flow_FollowUp_SAReviewCheck" sourceRef="Timer_FollowUp" targetRef="Gateway_FollowUpCheck" />
    <bpmn:sequenceFlow id="Flow_FollowUp_Yes" name="Received" sourceRef="Gateway_FollowUpCheck" targetRef="Gateway_MergeSAResults">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=saAoResponseReceived = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_FollowUp_No" name="Still no response" sourceRef="Gateway_FollowUpCheck" targetRef="Task_EscalateToCMS" />
    <bpmn:sequenceFlow id="Flow_Escalate_Forward" sourceRef="Task_EscalateToCMS" targetRef="Gateway_MergeSAResults" />
    <bpmn:sequenceFlow id="Flow_MergeSAResults_Log" sourceRef="Gateway_MergeSAResults" targetRef="Task_LogSAResults" />
    <bpmn:sequenceFlow id="Flow_LogSA_SiteVisitDetermination" sourceRef="Task_LogSAResults" targetRef="Task_SiteVisitDetermination" />
    <bpmn:sequenceFlow id="Flow_SiteVisitDec_Gateway" sourceRef="Task_SiteVisitDetermination" targetRef="Gateway_SiteVisit" />
    <bpmn:sequenceFlow id="Flow_SV_Yes" name="Yes" sourceRef="Gateway_SiteVisit" targetRef="Task_OrderSiteVisit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=siteVisitResult.siteVisitRequired = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SV_No" name="No" sourceRef="Gateway_SiteVisit" targetRef="Task_ForwardToCMS" />
    <bpmn:sequenceFlow id="Flow_OrderSV_Timer" sourceRef="Task_OrderSiteVisit" targetRef="Timer_SiteVisit" />
    <bpmn:sequenceFlow id="Flow_Timer_SVResults" sourceRef="Timer_SiteVisit" targetRef="Task_SiteVisitResults" />
    <bpmn:sequenceFlow id="Flow_SiteVisit_SAReferral" sourceRef="Task_SiteVisitResults" targetRef="Gateway_MergeSAReferral" />
    <bpmn:sequenceFlow id="Flow_Forward_CMSDecision" sourceRef="Task_ForwardToCMS" targetRef="Timer_CMSDecision" />
    <bpmn:sequenceFlow id="Flow_Timer_CMSCheck" sourceRef="Timer_CMSDecision" targetRef="Gateway_CMSDecision" />
    <bpmn:sequenceFlow id="Flow_CMS_Approved" name="Approved" sourceRef="Gateway_CMSDecision" targetRef="Task_SendApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=cmsDecision = "Approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CMS_Denied" name="Denied" sourceRef="Gateway_CMSDecision" targetRef="Task_SendDenial" />
    <bpmn:sequenceFlow id="Flow_Approval_End" sourceRef="Task_SendApproval" targetRef="EndEvent_Approved" />
    <bpmn:sequenceFlow id="Flow_Denial_End" sourceRef="Task_SendDenial" targetRef="EndEvent_Denied" />
    <bpmn:sequenceFlow id="Flow_058lvwi" sourceRef="Task_Intake" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="Flow_03h45ca" sourceRef="Task_ReviewResponse" targetRef="Gateway_MergeSAReferral" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="cms855i-mac-enrollment">
      <bpmndi:BPMNShape id="Start_ReceiveApp_di" bpmnElement="Start_ReceiveApp">
        <dc:Bounds x="162" y="532" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="155" y="575" width="54" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Intake_di" bpmnElement="Task_Intake">
        <dc:Bounds x="270" y="510" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Verify_di" bpmnElement="Task_Verify">
        <dc:Bounds x="670" y="510" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CompletenessCheck_di" bpmnElement="Task_CompletenessCheck">
        <dc:Bounds x="830" y="510" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Completeness_di" bpmnElement="Gateway_Completeness" isMarkerVisible="true">
        <dc:Bounds x="975" y="525" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1035" y="536" width="54" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DevelopmentRequest_di" bpmnElement="Task_DevelopmentRequest">
        <dc:Bounds x="1090" y="640" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Timer_ResponseWindow_di" bpmnElement="Timer_ResponseWindow">
        <dc:Bounds x="1252" y="662" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1231" y="705" width="82" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ResponseCheck_di" bpmnElement="Gateway_ResponseCheck" isMarkerVisible="true">
        <dc:Bounds x="1345" y="655" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1404.5" y="666" width="59" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReturnApplication_di" bpmnElement="Task_ReturnApplication">
        <dc:Bounds x="1460" y="760" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
